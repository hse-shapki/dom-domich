# Только пример. Рабочие токены и персональные данные не коммитить.
DATABASE_URL=postgresql+asyncpg://dom_domych:change-me@localhost:5432/dom_domych
POSTGRES_PASSWORD=change-me
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_INGRESS_MODE=webhook
PUBLIC_BASE_URL=https://example.invalid
PUBLIC_HOST=example.invalid
FILE_STORE_DIR=./var/files
WORKER_ID=dom-domych-worker-1
PAYLOAD_RETENTION_DAYS=30
# OpenAI-compatible llama-server. Модель и URL обязательны только inbox/scheduler.
LLM_BASE_URL=http://llama-server:8080
LLM_MODEL=dom-domych-demo
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=30
LLM_ATTEMPTS=2
