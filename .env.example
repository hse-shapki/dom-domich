# Только пример. Рабочие токены и персональные данные не коммитить.
# Для Compose имя хоста — postgres, а БД по умолчанию — dom_domych_demo.
DATABASE_URL=postgresql+asyncpg://dom_domych:change-me@postgres:5432/dom_domych_demo
POSTGRES_DB=dom_domych_demo
POSTGRES_PASSWORD=change-me
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_INGRESS_MODE=polling
PUBLIC_BASE_URL=https://example.invalid
PUBLIC_HOST=example.invalid
FILE_STORE_DIR=./var/files
WORKER_ID=dom-domych-worker-1
PAYLOAD_RETENTION_DAYS=30
# Для polling Compose на локальном Ollama используйте host.docker.internal, не 127.0.0.1.
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:4b
LLM_BACKEND=ollama
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=30
LLM_ATTEMPTS=2
